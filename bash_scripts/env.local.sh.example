# Per-machine overrides, sourced by every launcher under bash_scripts/ when the
# file exists as bash_scripts/env.local.sh (never exported to the public repo).
# Everything is optional: unset variables fall back to the launcher defaults.
#
# export PATH=/path/to/conda/envs/far/bin:$PATH   # the python env to run with
# export GPUS=0,1,2,3          # CUDA_VISIBLE_DEVICES for torchrun launchers (nproc = count)
# export EVAL_GPUS="0 1 2"     # one shard per GPU for the *_sharded.sh eval launchers
# export FAR_DEVICE=cuda:0     # device the notebooks use
